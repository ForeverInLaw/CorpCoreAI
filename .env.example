DATABASE_URL="postgresql://user:pass@host:5432/corpcoreai?schema=public"
POSTGRES_PASSWORD="changeme" # only for local db service, ignored with external DB
POSTGRES_DB="corpcoreai" # only for local db service
BOT_TOKEN="" # from @botfather
WHITELIST="" # telegram id, comma-separated
MANAGER_IDS="" # telegram id, comma-separated

# LLM provider — set one of:
#   Option A: OpenAI-compatible endpoint (any provider: OpenAI, Anthropic via proxy, Ollama, etc.)
LLM_API_KEY=""        # API key for the LLM provider
LLM_BASE_URL=""       # base URL (default: https://api.openai.com/v1)
LLM_MODEL=""          # model name (default: gpt-4o-mini)
#   Option B: NVIDIA (used as fallback if LLM_API_KEY is not set)
NVIDIA_API_KEY="nvapi-" # from https://build.nvidia.com/minimaxai/minimax-m2

# Voice transcription (NVIDIA Riva whisper-large-v3)
RIVA_WHISPER_FUNCTION_ID="b702f636-f60c-4a3d-a6f4-f3568c13bd7d"

# Cloudflare Tunnel (optional — exposes app via cloudflared)
CLOUDFLARE_TUNNEL_TOKEN=""