generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  MANAGER
}

enum TaskStatus {
  IN_PROGRESS
  DONE
  PAUSED
  OVERDUE
  CLOSED
}

enum AttachmentSource {
  TELEGRAM
  EXTERNAL
}

model User {
  id        BigInt   @id // Telegram ID
  role      Role     @default(EMPLOYEE)
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdTasks  Task[] @relation("CreatedTasks")
  assignedTasks Task[] @relation("AssignedTasks")
  uploadedFiles Attachment[]
}

model Task {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  status      TaskStatus @default(IN_PROGRESS)
  deadline    DateTime?
  subtasks    Json? // Array of strings or objects
  statusChangedAt          DateTime @default(now())
  completedAt              DateTime?
  lastDailyReminderAt      DateTime?
  lastDeadlineReminderAt   DateTime?
  deadlineDayNotifiedAt    DateTime?
  overdueNotifiedAt        DateTime?
  managerOverdueNotifiedAt DateTime?

  creatorId   BigInt
  creator     User     @relation("CreatedTasks", fields: [creatorId], references: [id])
  
  assigneeId  BigInt?
  assignee    User?    @relation("AssignedTasks", fields: [assigneeId], references: [id])

  attachments Attachment[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Attachment {
  id        Int      @id @default(autoincrement())
  url       String
  type      String // PDF, DOCX, IMAGE, etc.
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id])
  createdAt DateTime @default(now())

  source               AttachmentSource @default(TELEGRAM)
  telegramFileId       String?
  telegramUniqueFileId String?
  fileName             String?
  mimeType             String?
  sizeBytes            Int?
  storagePath          String?
  uploadedById         BigInt?
  uploadedBy           User?            @relation(fields: [uploadedById], references: [id])
  downloadTokens       DownloadToken[]
}

model DownloadToken {
  token        String     @id @default(uuid())
  attachmentId Int
  attachment   Attachment @relation(fields: [attachmentId], references: [id])
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  @@index([attachmentId])
  @@index([expiresAt])
}
