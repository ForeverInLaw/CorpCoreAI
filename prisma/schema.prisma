generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  engineType    = "client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  MANAGER
}

enum TaskStatus {
  IN_PROGRESS
  DONE
  PAUSED
  OVERDUE
  CLOSED
}

enum TaskCompletionReviewStatus {
  NOT_REQUESTED
  PENDING
  APPROVED
  REJECTED
}

enum AttachmentSource {
  TELEGRAM
  EXTERNAL
}

model User {
  id        BigInt   @id // Telegram ID
  role      Role     @default(EMPLOYEE)
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdTasks  Task[] @relation("CreatedTasks")
  assignedTasks Task[] @relation("AssignedTasks")
  taskAssignments TaskAssignment[]
  uploadedFiles Attachment[]
  historyEntries TaskHistory[] @relation("TaskHistoryActor")
  completionReviews Task[] @relation("TaskCompletionReviewer")
}

model Task {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  status      TaskStatus @default(IN_PROGRESS)
  completionReviewStatus TaskCompletionReviewStatus @default(NOT_REQUESTED)
  deadline    DateTime?
  subtasks    Json? // Array of strings or objects
  statusChangedAt          DateTime @default(now())
  completedAt              DateTime?
  completionRequestedAt    DateTime?
  completionReviewedAt     DateTime?
  completionReviewedById   BigInt?
  lastDailyReminderAt      DateTime?
  lastDeadlineReminderAt   DateTime?
  deadlineDayNotifiedAt    DateTime?
  overdueNotifiedAt        DateTime?
  managerOverdueNotifiedAt DateTime?
  overdueReason            String?

  creatorId   BigInt
  creator     User     @relation("CreatedTasks", fields: [creatorId], references: [id])
  
  assigneeId  BigInt?
  assignee    User?    @relation("AssignedTasks", fields: [assigneeId], references: [id])

  assignments TaskAssignment[]
  tags        TaskTag[]
  projects    TaskProject[]
  completionReviewedBy User? @relation("TaskCompletionReviewer", fields: [completionReviewedById], references: [id])

  attachments Attachment[]
  history     TaskHistory[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([creatorId])
  @@index([assigneeId])
  @@index([status])
  @@index([deadline])
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tags  Tag[]
  tasks TaskProject[]
}

model Tag {
  id          Int      @id @default(autoincrement())
  label       String
  color       String?
  projectId   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id])
  tasks   TaskTag[]

  @@unique([label, projectId])
}

model TaskAssignment {
  taskId    Int
  userId    BigInt
  isLead    Boolean  @default(false)
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@id([taskId, userId])
  @@index([userId])
}

model TaskTag {
  taskId Int
  tagId  Int

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id])

  @@id([taskId, tagId])
  @@index([tagId])
}

model TaskProject {
  taskId    Int
  projectId Int

  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id])

  @@id([taskId, projectId])
  @@index([projectId])
}

model Attachment {
  id        Int      @id @default(autoincrement())
  url       String
  type      String // PDF, DOCX, IMAGE, etc.
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  source               AttachmentSource @default(TELEGRAM)
  telegramFileId       String?
  telegramUniqueFileId String?
  fileName             String?
  mimeType             String?
  sizeBytes            Int? // ~2GB max (Int32); files >2GB not expected
  storagePath          String?
  uploadedById         BigInt?
  uploadedBy           User?            @relation(fields: [uploadedById], references: [id])
  downloadTokens       DownloadToken[]

  @@index([taskId])
}

model DownloadToken {
  token        String     @id @default(uuid())
  attachmentId Int
  attachment   Attachment @relation(fields: [attachmentId], references: [id])
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  @@index([attachmentId])
  @@index([expiresAt])
}

enum TaskHistoryType {
  STATUS_CHANGE
  DEADLINE_CHANGE
  ASSIGNEE_CHANGE
  OVERDUE_REASON
  TEAM_CHANGE
  TAG_CHANGE
  PROJECT_CHANGE
  REVIEW_STATUS_CHANGE
}

model TaskHistory {
  id        Int             @id @default(autoincrement())
  taskId    Int
  task      Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   BigInt?
  actor     User?           @relation("TaskHistoryActor", fields: [actorId], references: [id])
  type      TaskHistoryType
  details   Json?
  createdAt DateTime        @default(now())

  @@index([taskId, createdAt])
  @@index([createdAt])
}
